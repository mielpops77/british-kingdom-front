<?xml version="1.0" encoding="utf-8"?>
<!--
  Règles du serveur (Azure App Service, IIS) pour chatterie-british-kingdom.fr.
  Le nouveau site public (site-v2) est servi à la racine ; l'espace de gestion
  (application Angular) reste sur /admin, servi par admin.html.
  Ce fichier remplace, au moment de la publication, le web.config de l'application Angular
  (voir .github/workflows/main_britishkingdomfront.yml).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Les photos du site sont en WebP et la vidéo de l'accueil en MP4 : IIS doit connaître ces types -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
    </staticContent>
    <rewrite>
      <rules>
        <!-- 0. Une seule adresse pour le site : www.chatterie-british-kingdom.fr renvoie
                définitivement vers chatterie-british-kingdom.fr, pour ne pas avoir deux sites
                identiques aux yeux des moteurs de recherche. -->
        <rule name="Une seule adresse" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.(.+)$" />
          </conditions>
          <action type="Redirect" url="https://chatterie-british-kingdom.fr/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 1. Anciennes adresses du site Angular : redirection définitive vers les nouvelles pages,
                pour garder le référencement et les liens déjà partagés -->
        <rule name="Ancien accueil" stopProcessing="true">
          <match url="^accueil/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Ancienne fiche d'un chat" stopProcessing="true">
          <match url="^(males|femelles)/([0-9]+)/?$" />
          <action type="Redirect" url="/chat.html?id={R:2}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Ancienne portée" stopProcessing="true">
          <match url="^portee/([0-9]+)/?$" />
          <action type="Redirect" url="/portee.html?id={R:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Ancien blog" stopProcessing="true">
          <match url="^blog/?$" />
          <action type="Redirect" url="/conseils.html" redirectType="Permanent" />
        </rule>
        <rule name="Ancien article" stopProcessing="true">
          <match url="^blog/([^/]+)/?$" />
          <action type="Redirect" url="/article.html?slug={R:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Anciennes conditions" stopProcessing="true">
          <match url="^conditions/?$" />
          <action type="Redirect" url="/liste-attente.html" redirectType="Permanent" />
        </rule>

        <!-- 2. L'espace de gestion : toutes les adresses /admin/… ouvrent l'application Angular -->
        <!-- 1 bis. Liens courts pour les réseaux : chatterie-british-kingdom.fr/instagram mène à
                l'accueil (ou aux chatons) en gardant l'étiquette de provenance, plus joli dans une bio -->
        <rule name="Lien court Instagram" stopProcessing="true">
          <match url="^instagram/?$" />
          <action type="Redirect" url="/?utm_source=instagram&amp;utm_medium=bio" redirectType="Found" appendQueryString="false" />
        </rule>
        <rule name="Lien court Facebook" stopProcessing="true">
          <match url="^facebook/?$" />
          <action type="Redirect" url="/?utm_source=facebook&amp;utm_medium=page" redirectType="Found" appendQueryString="false" />
        </rule>
        <rule name="Lien court TikTok" stopProcessing="true">
          <match url="^tiktok/?$" />
          <action type="Redirect" url="/?utm_source=tiktok&amp;utm_medium=bio" redirectType="Found" appendQueryString="false" />
        </rule>
        <rule name="Lien court YouTube" stopProcessing="true">
          <match url="^youtube/?$" />
          <action type="Redirect" url="/?utm_source=youtube&amp;utm_medium=description" redirectType="Found" appendQueryString="false" />
        </rule>
        <rule name="Lien court chatons des réseaux" stopProcessing="true">
          <match url="^(instagram|facebook|tiktok|youtube)/chatons/?$" />
          <action type="Redirect" url="/chatons.html?utm_source={R:1}&amp;utm_medium=post" redirectType="Found" appendQueryString="false" />
        </rule>

        <rule name="Espace de gestion" stopProcessing="true">
          <match url="^admin(/.*)?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/admin.html" />
        </rule>

        <!-- 3. Les adresses sans .html du site actuel (/males, /chatons, /contact…) restent valables -->
        <rule name="Pages sans extension" stopProcessing="true">
          <match url="^([a-z0-9-]+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/{R:1}.html" />
        </rule>

        <!-- 4. Adresse inconnue : plus de renvoi silencieux vers l'accueil. IIS répond
                maintenant « 404 » et affiche 404.html (voir httpErrors ci-dessous), pour que les
                moteurs de recherche n'indexent pas des adresses qui n'existent pas. -->
      </rules>
    </rewrite>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" subStatusCode="-1" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
