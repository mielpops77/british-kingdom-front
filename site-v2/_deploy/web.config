<?xml version="1.0" encoding="utf-8"?>
<!--
  Règles du serveur (Azure App Service, IIS) pour chatterie-british-kingdom.fr.
  Le nouveau site public (site-v2) est servi à la racine ; l'espace de gestion
  (application Angular) reste sur /admin, servi par admin.html.
  Ce fichier remplace, au moment de la publication, le web.config de l'application Angular
  (voir .github/workflows/main_britishkingdomfront.yml).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Les photos du site sont en WebP : IIS doit connaître ce type de fichier -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <rewrite>
      <rules>
        <!-- 1. Anciennes adresses du site Angular : redirection définitive vers les nouvelles pages,
                pour garder le référencement et les liens déjà partagés -->
        <rule name="Ancien accueil" stopProcessing="true">
          <match url="^accueil/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Ancienne fiche d'un chat" stopProcessing="true">
          <match url="^(males|femelles)/([0-9]+)/?$" />
          <action type="Redirect" url="/chat.html?id={R:2}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Ancienne portée" stopProcessing="true">
          <match url="^portee/([0-9]+)/?$" />
          <action type="Redirect" url="/portee.html?id={R:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Ancien blog" stopProcessing="true">
          <match url="^blog/?$" />
          <action type="Redirect" url="/conseils.html" redirectType="Permanent" />
        </rule>
        <rule name="Ancien article" stopProcessing="true">
          <match url="^blog/([^/]+)/?$" />
          <action type="Redirect" url="/article.html?slug={R:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Anciennes conditions" stopProcessing="true">
          <match url="^conditions/?$" />
          <action type="Redirect" url="/liste-attente.html" redirectType="Permanent" />
        </rule>

        <!-- 2. L'espace de gestion : toutes les adresses /admin/… ouvrent l'application Angular -->
        <rule name="Espace de gestion" stopProcessing="true">
          <match url="^admin(/.*)?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/admin.html" />
        </rule>

        <!-- 3. Les adresses sans .html du site actuel (/males, /chatons, /contact…) restent valables -->
        <rule name="Pages sans extension" stopProcessing="true">
          <match url="^([a-z0-9-]+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/{R:1}.html" />
        </rule>

        <!-- 4. Adresse inconnue : l'accueil, comme le faisait le site actuel -->
        <rule name="Adresse inconnue" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
